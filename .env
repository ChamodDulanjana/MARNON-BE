#using development environment will automatically create db if it doesn't exists , to prevent it use production environment
#NODE_ENV='production'
NODE_ENV='development'

#backend running port
PORT=3200

SERVER_URL=marnon/api

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=#username
DB_PASSWORD=#password
DB_NAME=marnon

JWT_SECRET=#YOUR_JWT_SECRET_KEY
JWT_EXPIRES_IN=#YOUR_JWT_EXPIRES_TIME # e.g. 1d, 2h, 30m, 15s

COOKIE_MAX_AGE=#YOUR_COOKIE_MAX_AGE # e.g. 3600000 (in milliseconds)

OTP_EXPIRES_IN=#YOUR_OTP_EXPIRES_TIME # 5 minutes in milliseconds

DOMAIN=#YOUR_DOMAIN # e.g. example.com

VITE_WEB=#YOUR_WEB_URL
VITE_ADMIN_PANEL=#YOUR_ADMIN_PANEL_URL

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=#EMAIL
MAIL_PASS=#APP_PASSWORD